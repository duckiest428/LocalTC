# What a release zip (git archive) carries: the release is what the installer sets up and the updater
# mirrors over an install, so only what LocalTC needs to run goes in. An allowlist: everything at the top of
# the repository is left out (the website, the server, the iOS app, tests, tools, docs ...), then the few
# things an install needs are let back in. Something new at the top stays out unless it's added here.
/* export-ignore
/.* export-ignore
/src -export-ignore
/config -export-ignore
/install -export-ignore
/pyproject.toml -export-ignore
/LICENSE -export-ignore
/README.md -export-ignore
/CHANGELOG.md -export-ignore
/Install[[:space:]]LocalTC.cmd -export-ignore
# Inside those, nothing built or cached.
__pycache__ export-ignore
*.pyc export-ignore
.DS_Store export-ignore
